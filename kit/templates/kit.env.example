# Values for templates/render.sh. Copy to kit.env, edit, then run:
#   bash render.sh kit.env /path/to/output-dir
# Plain KEY=value lines, no quotes, no spaces around "=".

# Bot name: lowercase, no spaces. Used as the SilverBullet account name, the
# @mention handle, the tmux pane title and the tailscale service prefix.
BOT_NAME=mybot
# How the bot refers to you in prose.
HUMAN_NAME=Alex
# Your SilverBullet account name and @mention handle (lowercase).
HUMAN_HANDLE=alex
# Unix user the bot runs as, and its home directory.
UNIX_USER=alex
HOME_DIR=/home/alex
# The vault: the bot's working directory and the SilverBullet space.
VAULT_DIR=/home/alex/mybot
# Claude Code's per-project folder name under ~/.claude/projects/. It is
# VAULT_DIR with every "/" replaced by "-". Check with: ls ~/.claude/projects/
PROJECT_SLUG=-home-alex-mybot
# Output of `id -u` and `id -g` for UNIX_USER.
BOT_UID=1000
BOT_GID=1000
# IANA timezone of the box (`timedatectl show -p Timezone --value`).
TIMEZONE=Europe/Berlin
# Tailnet name: the part before .ts.net in your MagicDNS names.
TAILNET=example-tailnet
# Localhost ports for SilverBullet and the web terminal.
SB_PORT=3001
TERM_PORT=3000
# Host directory for SilverBullet's own state (accounts, spaces.json).
SB_DATA_DIR=/srv/silverbullet/sbdata
# Where the bot's tokens and passwords live. Must be OUTSIDE VAULT_DIR:
# SilverBullet serves any file in the vault, dotfiles included.
SECRETS_DIR=/home/alex/.config/mybot/secrets
